{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build CoreJava",
            "type": "shell",
            "command": "find CoreJava/src -name '*.java' -print0 | xargs -0 javac -d CoreJava/bin",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}